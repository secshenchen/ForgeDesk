execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE status OUTPUT_VARIABLE output)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Bootstrap exited with ${status}")
endif()
foreach(field IN ITEMS "ForgeDesk Bootstrap" "Version: ${VERSION}" "Compiler:" "C++23" "Build: ${CONFIG}" "Platform:")
    string(FIND "${output}" "${field}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing ${field} in bootstrap output:\n${output}")
    endif()
endforeach()
